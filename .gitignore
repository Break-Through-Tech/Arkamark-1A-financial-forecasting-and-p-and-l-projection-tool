# R session junk. .RData in particular saves the entire workspace to disk and
# had grown to 33MB of data frames.
.RData
.Rhistory
.Rapp.history
.Rproj.user/
*.Rproj.user

# OS
.DS_Store
Thumbs.db

# Derived data. Everything in data/clean/ is regenerated by
# Rscript R/02_clean_financials.R from the raw CSVs already tracked in data/.
# Committing it would add 50MB that goes stale the moment the pipeline changes.
data/clean/

# Generated reports. The two written documents in reports/ ARE tracked:
# eda_findings.md and cleaning_decisions.md. Only the auto-generated run
# artifacts are ignored.
reports/eda_financials.txt
reports/cleaning_log.txt

# Stray output folders created if a script is run with the wrong working
# directory. Should not recur, but harmless to guard.
R/data/
R/reports/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/
