# R session junk. .RData in particular saves the entire workspace to disk and
# had grown to 33MB of data frames.
.RData
.Rhistory
.Rapp.history
.Rproj.user/
*.Rproj.user

# OS
.DS_Store
Thumbs.db

# Derived data. Everything in data/clean/ is regenerated by
data/clean_r_baseline/

# Stray output folders created if a script is run with the wrong working
# directory. Should not recur, but harmless to guard.
R/data/
R/reports/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/
